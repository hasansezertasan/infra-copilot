{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hasansezertasan/renovate-config"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "before 4am on monday"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Group repository-maintenance tooling into one weekly PR",
      "matchManagers": [
        "github-actions",
        "npm"
      ],
      "groupName": "repository tooling",
      "automerge": false
    }
  ]
}
