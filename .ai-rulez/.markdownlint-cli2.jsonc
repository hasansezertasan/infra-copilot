{
  // Verified honoured: linting from the repository root with markdownlint-cli2 0.23.2
  // applies this file to everything beneath .ai-rulez. Removing it and changing nothing
  // else takes the same run from 0 to 119 MD013 findings, so `make lint` in CI is the
  // enforcement — if a future version stopped applying nested configuration, lint would
  // fail loudly rather than silently widening what goes unchecked. The version is pinned
  // in the Makefile and asserted by validate_tool_pins.
  // The canonical behavioural sources are linted for real defects — unlabelled fences,
  // fences without surrounding blank lines, headings without them — but not for line
  // width. Their prose is written long and no cap fixes it: 94 lines still exceed 140
  // columns, so MD013 here would mean reflowing every behavioural instruction in the
  // repository for no gain. Width is enforced on the hand-authored top-level documents,
  // where it was measured to already hold.
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD046": { "style": "fenced" },
    "MD060": false
  }
}
