{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "infra-copilot",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {"type": "toml", "path": ".ai-rulez/config.toml", "jsonpath": "$.plugin.version"},
        {"type": "json", "path": ".agents/plugins/marketplace.json", "jsonpath": "$.plugins[*].version"},
        {"type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[*].version"},
        {"type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version"},
        {"type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version"}
      ]
    }
  }
}
